# Public site origin used by CORS. Replace if you choose a different domain.
ALLOWED_ORIGINS=https://deckreps.app

# Optional extra origin regex. Leave blank unless you need preview domains.
ALLOWED_ORIGIN_REGEX=

# Host port for docker compose.
WEB_PORT=8000
VITE_SUPPORT_EMAIL=support@deckreps.app
VITE_DONATION_URL=https://ko-fi.com/sheltron
ENVIRONMENT=production

# Generate a long random value before deploying:
# openssl rand -hex 32
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Public hardening defaults.
TRUST_PROXY_HEADERS=true
MAX_REQUEST_BODY_BYTES=2097152
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=240
RATE_LIMIT_DECK_GENERATION_PER_MINUTE=6
RATE_LIMIT_DECK_REGEN_PER_MINUTE=10
RATE_LIMIT_DECK_IMPORT_PER_MINUTE=20
RATE_LIMIT_AI_DECK_PER_MINUTE=10
RATE_LIMIT_SPAWN_PER_MINUTE=30
RATE_LIMIT_DECIDE_PER_MINUTE=120
RATE_LIMIT_CHAT_PER_MINUTE=60
RATE_LIMIT_FEEDBACK_PER_MINUTE=10

# AdSense build-time settings. Rebuild the frontend/container after changing these.
VITE_ENABLE_ADS=true
VITE_REQUIRE_AD_CONSENT=true
VITE_SHOW_AD_PLACEHOLDERS=false
VITE_ADSENSE_TEST=false
VITE_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
VITE_ADSENSE_SLOT_LEADERBOARD=0000000000
VITE_ADSENSE_SLOT_MOBILE_BANNER=0000000000
VITE_ADSENSE_SLOT_SIDEBAR=0000000000
VITE_SHELECTOR_API_BASE=/shelector-api

# Same publisher ID without the "ca-" prefix, used to generate /ads.txt.
ADS_TXT_PUBLISHER_ID=pub-0000000000000000
